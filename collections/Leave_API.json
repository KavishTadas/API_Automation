{
  "info": {
    "name": "Leave API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "TC01 - Show leave report returns records array",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const label = pm.iterationData.get('testLabel')",
              "  || 'unlabelled iteration';",
              "const expectRecords = pm.iterationData.get(",
              "  'expectRecords') === 'true';",
              "const statusCode = pm.response.code;",
              "",
              "console.log('\\n--- ' + label + ' ---');",
              "",
              "if (statusCode === 401 || statusCode === 403) {",
              "  pm.test(label + ' — BLOCKED: no authToken',",
              "    function () {",
              "    pm.expect.fail('Got ' + statusCode",
              "      + ' — Login must run first');",
              "  });",
              "} else {",
              "  const json = pm.response.json();",
              "",
              "  pm.test(label + ' — status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "",
              "  pm.test(label + ' — has records array', function () {",
              "    pm.expect(json).to.have.property('records');",
              "    pm.expect(json.records).to.be.an('array');",
              "  });",
              "",
              "  if (expectRecords) {",
              "    pm.test(label + ' — records array non-empty',",
              "      function () {",
              "      pm.expect(json.records.length).to.be.above(0);",
              "    });",
              "  } else {",
              "    console.log('Empty records expected for: ' + label);",
              "  }",
              "",
              "  pm.test(label + ' — response time under 5000ms',",
              "    function () {",
              "    pm.expect(pm.response.responseTime)",
              "      .to.be.below(5000);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"startDate\":\"{{startDate}}\",\"endDate\":\"{{endDate}}\"}"
        },
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/showleavereport",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "showleavereport"]
        }
      }
    },

    {
      "name": "TC02 - Show leave report rejects missing auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC02 - Status is 401 or 403 without token', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2020-01-01\",\n  \"endDate\": \"2026-12-31\"\n}"
        },
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/showleavereport",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "showleavereport"]
        }
      }
    },

    {
      "name": "TC03 - Pending approvals returns pendingleavs array",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('TC03 - Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC03 - Response has pendingleavs array', function () {",
              "  pm.expect(json).to.have.property('pendingleavs');",
              "  pm.expect(json.pendingleavs).to.be.an('array');",
              "});",
              "",
              "pm.test('TC03 - Response time under 5000ms', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});",
              "",
              "if (json.pendingleavs && json.pendingleavs.length > 0) {",
              "  const r = json.pendingleavs[0];",
              "",
              "  pm.test('TC03 - Record has all required fields', function () {",
              "    pm.expect(r).to.have.property('lr_id');",
              "    pm.expect(r).to.have.property('lr_no');",
              "    pm.expect(r).to.have.property('emp_name');",
              "    pm.expect(r).to.have.property('leave_type');",
              "    pm.expect(r).to.have.property('leave_count');",
              "    pm.expect(r).to.have.property('day_type');",
              "    pm.expect(r).to.have.property('approver_type');",
              "    pm.expect(r).to.have.property('startdate');",
              "    pm.expect(r).to.have.property('enddate');",
              "  });",
              "",
              "  pm.test('TC03 - leave_count is a positive number', function () {",
              "    pm.expect(r.leave_count).to.be.a('number');",
              "    pm.expect(r.leave_count).to.be.above(0);",
              "  });",
              "",
              "  pm.test('TC03 - approver_type is Administrative or Functional', function () {",
              "    pm.expect(['Administrative', 'Functional'])",
              "      .to.include(r.approver_type);",
              "  });",
              "",
              "  pm.test('TC03 - leave_type is a known value', function () {",
              "    const validTypes = ['CL','LWP','PL','SL','ML','EL'];",
              "    pm.expect(validTypes).to.include(r.leave_type);",
              "  });",
              "",
              "  console.log('Pending approvals: ' + json.pendingleavs.length);",
              "} else {",
              "  console.log('pendingleavs array is empty - no pending approvals for this user');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/approvals",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "approvals"]
        }
      }
    },

    {
      "name": "TC04 - Pending approvals rejects missing auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC04 - Status is 401 or 403 without token', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/approvals",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "approvals"]
        }
      }
    }

  ]
}
