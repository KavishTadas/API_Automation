{
  "info": {
    "name": "Leave API",
    "description": "Observed monthly leave-report contract and authorization checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC01/TC03 - Get all leave reports and validate structure",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const label = pm.iterationData.get('testLabel') || 'unlabelled iteration';",
              "const caseType = pm.iterationData.get('caseType') || 'valid';",
              "const expectedStatus = Number(pm.iterationData.get('expectedStatus') || 200);",
              "const requireTwoRecords = pm.iterationData.get('spotCheckItems') === 'true';",
              "const actualStatus = pm.response.code;",
              "",
              "console.log('[Leave_API][AUTHENTICATED] ' + label + ' HTTP ' + actualStatus);",
              "pm.test(label + ' - expected HTTP ' + expectedStatus, function () {",
              "  pm.expect(actualStatus).to.equal(expectedStatus);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (caseType === 'valid') {",
              "  pm.test('TC01 - Status is 200 - ' + label, function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "",
              "  pm.test('TC01 - Response has status, message, data.count and data.leaveReport - ' + label, function () {",
              "    pm.expect(json).to.have.property('status').that.is.a('string');",
              "    pm.expect(json).to.have.property('message').that.is.a('string');",
              "    pm.expect(json).to.have.property('data').that.is.an('object');",
              "    pm.expect(json.data).to.have.property('count').that.is.an('object');",
              "    pm.expect(json.data).to.have.property('leaveReport').that.is.an('array');",
              "  });",
              "",
              "  pm.test('TC01 - Count contains observed integer fields - ' + label, function () {",
              "    ['rejected', 'cancelled', 'pending', 'approved'].forEach(function (field) {",
              "      pm.expect(json.data.count).to.have.property(field);",
              "      pm.expect(Number.isInteger(json.data.count[field])).to.equal(true);",
              "    });",
              "  });",
              "",
              "  const reports = json.data.leaveReport;",
              "  if (reports.length >= 2) {",
              "    const expectedFields = [",
              "      'lr_no', 'lr_id', 'subject', 'application_date', 'status',",
              "      'start_date', 'end_date', 'leave_type', 'emp_name', 'day_type',",
              "      'empid', 'purpose', 'reason'",
              "    ];",
              "    const integerFields = ['lr_no', 'lr_id', 'empid'];",
              "    const stringFields = [",
              "      'subject', 'application_date', 'status', 'start_date', 'end_date',",
              "      'leave_type', 'emp_name', 'day_type', 'purpose'",
              "    ];",
              "",
              "    pm.test('TC03 - First two records contain all 13 expected fields - ' + label, function () {",
              "      reports.slice(0, 2).forEach(function (record) {",
              "        expectedFields.forEach(function (field) {",
              "          pm.expect(record).to.have.property(field);",
              "        });",
              "        integerFields.forEach(function (field) {",
              "          pm.expect(Number.isInteger(record[field])).to.equal(true);",
              "        });",
              "        stringFields.forEach(function (field) {",
              "          pm.expect(record[field]).to.be.a('string');",
              "        });",
              "        pm.expect(record.reason === null || typeof record.reason === 'string').to.equal(true);",
              "      });",
              "    });",
              "    console.log('[Leave_API][TC03] spot-checked 2 records for ' + label);",
              "  } else if (requireTwoRecords) {",
              "    pm.test('TC03 - At least two records available for required spot-check - ' + label, function () {",
              "      pm.expect(reports.length).to.be.at.least(2);",
              "    });",
              "  } else {",
              "    console.log('[Leave_API][TC03] fewer than 2 records; spot-check not required for ' + label);",
              "  }",
              "} else {",
              "  pm.test('TC04 - Invalid month returns observed error structure - ' + label, function () {",
              "    pm.expect(json).to.have.property('status', 'error');",
              "    pm.expect(json).to.have.property('message').that.is.a('string');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/getAllLeaveReports?month={{month}}&year={{year}}",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "getAllLeaveReports"],
          "query": [
            { "key": "month", "value": "{{month}}" },
            { "key": "year", "value": "{{year}}" }
          ]
        }
      }
    },
    {
      "name": "TC02 - Invalid token returns observed authorization status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Leave_API][INVALID_TOKEN] HTTP ' + pm.response.code);",
              "pm.test('TC02 - Invalid token returns observed HTTP 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "const json = pm.response.json();",
              "pm.test('TC02 - Invalid token response has observed error structure', function () {",
              "  pm.expect(json).to.have.property('status', 'error');",
              "  pm.expect(json).to.have.property('message').that.is.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-token-value",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{leaveBaseUrl}}/user/leaves/getAllLeaveReports?month=4&year=2026",
          "host": ["{{leaveBaseUrl}}"],
          "path": ["user", "leaves", "getAllLeaveReports"],
          "query": [
            { "key": "month", "value": "4" },
            { "key": "year", "value": "2026" }
          ]
        }
      }
    }
  ]
}
