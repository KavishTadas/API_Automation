{
  "info": {
    "name": "User API",
    "description": "OUT OF HCM SCOPE: local FastAPI sample routes only. The .pending. filename keeps this collection out of Newman and generated HCM pytest CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET root returns health message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response body is correct', function () {",
              "  pm.expect(pm.response.json()).to.eql({ message: 'Hello' });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET about returns about message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response body is correct', function () {",
              "  pm.expect(pm.response.json()).to.eql({ message: 'This is the about page.' });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/about",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "about"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST message creates a message",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set('messageName', `qa-message-${Date.now()}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('message payload is returned', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body.message).to.have.property('msg_id').that.is.a('number');",
              "  pm.expect(body.message.msg_name).to.eql(pm.variables.get('messageName'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/messages/{{messageName}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "messages",
            "{{messageName}}",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET messages returns message collection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('messages collection is returned', function () {",
              "  pm.expect(pm.response.json()).to.have.property('messages:');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "messages"
          ]
        }
      },
      "response": []
    }
  ]
}
