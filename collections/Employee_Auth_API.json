            "  ajv.addSchema(schemaBundle);",
            "  const validate = ajv.getSchema(schemaBundle.$id + '#/components/schemas/' + schemaName);",
            "  pm.expect(validate, 'Compiled OpenAPI schema ' + schemaName + ' must exist').to.be.a('function');",
            "  const valid = validate(payload);",
            "  const errors = validate.errors || [];",
            "  const details = errors.slice(0, 5).map(function (error) {",
            "    return (error.dataPath || '/') + ' ' + error.message + ' (' + error.schemaPath + ')';",
            "  }).join('; ') + (errors.length > 5 ? '; ... ' + (errors.length - 5) + ' additional violation(s)' : '');",
            "  pm.expect(valid, (context || schemaName) + ' failed OpenAPI schema validation: ' + details).to.equal(true);",
            "}",
            "pm.test('TC02 - Status is 400 for bad empCode', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('TC02 - Full response matches OpenAPI ErrorResponse', function() {",
            "  assertOpenApiSchema('ErrorResponse', json, 'Invalid-empCode error response');",
            "});",
            "pm.test('TC02 - Error message returned', function() {",
            "  pm.expect(json).to.have.property('message');",
            "  pm.expect(json.message).to.be.a('string');",
            "});"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"empCode\": \"INVALID-999\", \"password\": \"wrongpassword\"}"
        },
        "url": {
          "raw": "{{authBaseUrl}}/auth/token",
          "host": ["{{authBaseUrl}}"],
          "path": ["auth", "token"]
        }
      }
    },
