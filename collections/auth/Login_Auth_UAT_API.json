{
  "info": {
    "name": "Login Auth UAT API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC01 - Valid credentials return token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const label = pm.iterationData.get('testLabel')",
              "  || 'unlabelled iteration';",
              "const expectedStatus = parseInt(",
              "  pm.iterationData.get('expectedStatus') || '200'",
              ");",
              "const expectedOutcome = pm.iterationData.get(",
              "  'expectedOutcome') || 'token';",
              "const json = pm.response.json();",
              "",
              "console.log('\\n--- ' + label + ' ---');",
              "console.log('Status: ' + pm.response.code);",
              "",
              "pm.test(label + ' — status is ' + expectedStatus,",
              "  function () {",
              "  pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "if (expectedOutcome === 'token') {",
              "  pm.test(label + ' — token is present', function () {",
              "    pm.expect(json).to.have.property('token');",
              "    pm.expect(json.token).to.be.a('string')",
              "      .and.to.have.length.above(20);",
              "  });",
              "  pm.test(label + ' — empCode matches', function () {",
              "    pm.expect(json.empCode).to.equal(",
              "      pm.iterationData.get('empCode'));",
              "  });",
              "  pm.test(label + ' — username non-empty', function () {",
              "    pm.expect(json.username).to.be.a('string')",
              "      .and.to.have.length.above(0);",
              "  });",
              "  pm.test(label + ' — roles is array', function () {",
              "    pm.expect(json.roles).to.be.an('array')",
              "      .and.to.have.length.above(0);",
              "  });",
              "  if (json.token) {",
              "    pm.environment.set('authToken', json.token);",
              "    console.log('authToken stored — length: '",
              "      + json.token.length);",
              "  }",
              "} else {",
              "  pm.test(label + ' — message field present',",
              "    function () {",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json.message).to.be.a('string')",
              "      .and.to.have.length.above(0);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empCode\": \"{{empCode}}\",\n  \"password\": \"{{empPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        }
      }
    }
  ]
}
