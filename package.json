{
  "name": "hcm-api-automation",
  "version": "1.0.0",
  "scripts": {
    "test:local": "cross-env ENV=local node scripts/run-newman.js",
    "test:staging": "cross-env ENV=staging node scripts/run-newman.js",
    "test:production": "cross-env ENV=production node scripts/run-newman.js",
    "test:all": "npm run test:local && npm run test:staging",
    "test:uat": "cross-env ENV=uat node scripts/run-newman.js",
    "lint:spec": "spectral lint openapi/openapi.yaml --ruleset openapi/.spectral.yaml",
    "report:generate": "node scripts/generate-allure.js",
    "report:html": "node scripts/generate-html-index.js",
    "report:open": "allure open reports/allure-report",
    "monitor:run": "node monitoring/health-check.js"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.1",
    "ajv": "^8.20.0",
    "allure-commandline": "2.29.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "newman": "6.2.2",
    "newman-reporter-allure": "2.15.1",
    "newman-reporter-htmlextra": "1.23.1",
    "yaml": "^2.9.0"
  }
}
