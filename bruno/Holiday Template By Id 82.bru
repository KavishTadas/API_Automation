meta {
  name: Holiday Template By Id 82
  type: http
  seq: 4
}

get {
  url: {{attendanceBaseUrl}}/api/attendance/holiday-templates/getById/82
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

tests {
  test("Status is 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Returns the requested template", function() {
    expect(res.getBody().data.holidayTemplateId).to.equal(82);
  });
}
