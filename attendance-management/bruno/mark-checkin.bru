meta {
  name: Mark Check-In
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/user/attendance/checkin
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "empCode": "{{empCode}}",
    "checkInTime": "09:00:00",
    "location": "Office"
  }
}

tests {
  test("Status is 200 or 201", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
}
