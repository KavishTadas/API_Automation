# Selects environments/<name>.json for Newman and monitoring; use the UAT configuration by default.
ENV=uat
# Overrides ENV for generated Python tests when they need a different Postman environment file.
API_TEST_ENV=uat
# Sets the generated Python HTTP request timeout, in seconds, for auth and HCM API calls.
API_TEST_TIMEOUT=30

# Supplies the shared/legacy HCM API fallback used by Newman, monitoring, and retained Bruno flows.
BASE_URL=https://uatmcdphcmplatform.omfysgroup.com
# Supplies the Employee Auth API host used by monitoring and generated Python auth requests.
AUTH_BASE_URL=https://uat-mcdp-be.omfysgroup.com
# Supplies the Leave HCM platform host used by Newman, monitoring, and generated leave-report requests.
LEAVE_BASE_URL=https://devmcdphcmplatform.omfysgroup.com
# Supplies the Attendance HCM platform host used by Newman, monitoring, and attendance requests.
ATTENDANCE_BASE_URL=https://uatmcdphcmplatform.omfysgroup.com
# Overrides the auth host only for Newman retry regression probes; leave empty for normal pinned-host runs.
NEWMAN_RETRY_PROBE_AUTH_BASE_URL=

# --- Base URL convention for tests/global_contract (local and platform-driven runs) ---
# The API documentation template has no "Base URL Key" column, so the global
# contract tier derives the key from the API's Module value and the target
# environment, then falls through in this order:
#   1. <MODULE>_BASE_URL_<ENV>  e.g. Module "HCM - Attendance Management" + UAT
#                                    -> ATTENDANCE_BASE_URL_UAT
#   2. <MODULE>_BASE_URL        e.g. ATTENDANCE_BASE_URL (the keys already above)
#   3. the literal "Base URL" column on the API's own definition row
#   4. nothing resolves -> the check reports NOT_APPLICABLE naming the key it looked for
#
# Within steps 1 and 2 the module name is matched in two passes, and the match
# must be UNIQUE:
#   a. the full normalized module name       "Employee Auth" -> EMPLOYEE_AUTH_BASE_URL
#   b. then each individual token            "Employee Auth" -> AUTH_BASE_URL
# Generic words (HCM, API, Management, Module, Service) are dropped, so
# "HCM - Attendance Management" reaches ATTENDANCE_BASE_URL without a lookup
# table. If two tokens BOTH name registered keys the run reports an explicit
# ambiguity naming both and resolves nothing — it never picks one. A silently
# misrouted host is exactly the failure that CI's hardcoded URLs exist to
# prevent, and it shows up as a passing run against the wrong environment.
#
# Adding a new <MODULE>_BASE_URL_<ENV> key makes that environment selectable
# with no code change.
#
# Environment names: normalized to uppercase with every non-alphanumeric run
# collapsed to one underscore, so uat / UAT / Uat are the same environment. The
# set of VALID environments is derived from the <MODULE>_BASE_URL_<ENV> keys
# registered below — never a hardcoded list. A manifest naming an environment
# outside that set is rejected, and the error lists the registered set. If no
# env-suffixed key is registered at all, the unsuffixed <MODULE>_BASE_URL keys
# serve every environment and no check applies.
#
# NOTE: .github/workflows/api-tests.yml hardcodes AUTH_BASE_URL, LEAVE_BASE_URL
# and ATTENDANCE_BASE_URL deliberately — a stale LEAVE_BASE_URL secret once
# silently redirected CI to an old host. This convention covers local and
# platform-driven runs only and does not change CI.

# Current UAT hosts, registered under the environment-suffixed convention. Dev,
# QA and Prod keys land when the dev team supplies those hosts.
AUTH_BASE_URL_UAT=https://uat-mcdp-be.omfysgroup.com
LEAVE_BASE_URL_UAT=https://devmcdphcmplatform.omfysgroup.com
ATTENDANCE_BASE_URL_UAT=https://uatmcdphcmplatform.omfysgroup.com

# --- Credential aliases for run manifests ---
# A run manifest names a credentialAlias — a label, never a value. The raw
# credential is resolved at run time from these keys: the alias uppercased with
# every non-alphanumeric run collapsed to a single underscore.
#   credentialAlias "attendance-svc-uat-01"
#     -> CRED_ATTENDANCE_SVC_UAT_01_EMP_CODE
#     -> CRED_ATTENDANCE_SVC_UAT_01_EMP_PASSWORD
# An unresolvable alias fails the run naming the alias and the keys it looked
# for; the value never appears in a log, report, or Allure attachment.
# COMMIT NO REAL VALUES — register these in CI secrets or a local .env.
# CRED_ATTENDANCE_SVC_UAT_01_EMP_CODE=your_service_account_code_here
# CRED_ATTENDANCE_SVC_UAT_01_EMP_PASSWORD=your_service_account_password_here

# Optional path to a run manifest (JSON) selecting which APIs to test, relative
# to the repo root. Unset means the tier enumerates openapi.yaml exactly as it
# did before, which is the no-regression default.
GLOBAL_CONTRACT_RUN_MANIFEST=

# Set to 1 to run the global contract tier's CORS preflight check. Off by default:
# these are internal server-to-server APIs behind the WAF and are not expected to
# emit Access-Control-* headers, so the check would go red across the board.
GLOBAL_CONTRACT_ENABLE_CORS_PREFLIGHT=0
# Optional path to a JSON file of API definitions for the global contract tier,
# relative to the repo root. Lets an API be exercised before the Excel and cURL
# parsers exist. Unset means the tier uses openapi.yaml and the generated
# inventory only. An unreadable or malformed file is ignored, never fatal.
GLOBAL_CONTRACT_API_DEFINITIONS=

# Supplies the Employee Auth API employee-code credential for Newman, monitoring, and TLS tests.
EMP_CODE=your_employee_code_here
# Supplies the Employee Auth API password credential for Newman, monitoring, and TLS tests.
EMP_PASSWORD=your_employee_password_here
# Optional fallback bearer token for generated Python HCM requests. The pytest session
# mints its own token and that value takes precedence, so leave this blank unless no
# bootstrap is possible; a stale value here is ignored rather than causing 401s.
AUTH_TOKEN=your_optional_bearer_token_here
# Supplies the alternate CI bearer token name accepted by generated Python HCM requests.
API_AUTH_TOKEN=your_optional_api_bearer_token_here
# Supplies the Postman-style bearer token alias accepted by the generated Python resolver.
authToken=your_optional_postman_bearer_token_here
# Supplies the dormant backward-compatible bearer token alias accepted by the generated Python resolver.
AUTHTOKEN=your_optional_legacy_bearer_token_here

# Limits Newman to a comma-separated collection list, or all for the complete Employee Auth and Leave suite.
COLLECTION_FILTER=all
# Enables pinned Employee Auth TLS fingerprint diagnostics when set to 1; use 0 for normal runs.
PINNED_TLS_DEBUG=0

# Authenticates scripts/postman-cli-run.sh with the Postman cloud service.
POSTMAN_API_KEY=your_postman_api_key_here
# Identifies the Postman cloud environment used by the UAT Postman CLI target.
POSTMAN_UAT_ENV_UID=your_postman_uat_environment_uid_here
# Identifies the Postman cloud environment used by the local Postman CLI target.
POSTMAN_LOCAL_ENV_UID=your_postman_local_environment_uid_here

# CI-only variables are configured by GitHub/Jenkins and are not needed in local .env files.
# SLACK_WEBHOOK_URL is a GitHub repository secret used only by the Actions failure-notification step.
# GITHUB_STEP_SUMMARY is supplied automatically by the GitHub Actions runner for job summaries.
# BUILD_NUMBER and BUILD_URL are supplied automatically by Jenkins for notification metadata.
# ENVIRONMENT, COLLECTION, and NOTIFY_EMAIL are Jenkins job parameters rather than local environment variables.
# USERNAME and PASSWORD were removed from GitHub Actions because current repository code does not consume them.
