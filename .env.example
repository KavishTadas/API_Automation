# Selects environments/<name>.json for Newman and monitoring; use the UAT configuration by default.
ENV=uat
# Overrides ENV for generated Python tests when they need a different Postman environment file.
API_TEST_ENV=uat
# Sets the generated Python HTTP request timeout, in seconds, for auth and HCM API calls.
API_TEST_TIMEOUT=30

# Supplies the shared/legacy HCM API fallback used by Newman, monitoring, and retained Bruno flows.
BASE_URL=https://uat-mcdp-be.omfysgroup.com
# Supplies the Employee Auth API host used by monitoring and generated Python auth requests.
AUTH_BASE_URL=https://dev_mcdp_be.omfysgroup.com
# Supplies the Leave HCM platform host used by Newman, monitoring, and generated leave-report requests.
LEAVE_BASE_URL=https://devmcdphcmplatform.omfysgroup.com
# Supplies the Attendance HCM platform host used by Newman, monitoring, and attendance requests.
ATTENDANCE_BASE_URL=https://uat_mcdp_hcm.omfysgroup.com
# Overrides the auth host only for Newman retry regression probes; leave empty for normal pinned-host runs.
NEWMAN_RETRY_PROBE_AUTH_BASE_URL=

# Supplies the Employee Auth API employee-code credential for Newman, monitoring, and TLS tests.
EMP_CODE=your_employee_code_here
# Supplies the Employee Auth API password credential for Newman, monitoring, and TLS tests.
EMP_PASSWORD=your_employee_password_here
# Supplies an optional canonical bearer token override for generated Python HCM requests.
AUTH_TOKEN=your_optional_bearer_token_here
# Supplies the alternate CI bearer token name accepted by generated Python HCM requests.
API_AUTH_TOKEN=your_optional_api_bearer_token_here
# Supplies the Postman-style bearer token alias accepted by the generated Python resolver.
authToken=your_optional_postman_bearer_token_here
# Supplies the dormant backward-compatible bearer token alias accepted by the generated Python resolver.
AUTHTOKEN=your_optional_legacy_bearer_token_here

# Limits Newman to a comma-separated collection list, or all for the complete Employee Auth and Leave suite.
COLLECTION_FILTER=all
# Enables pinned Employee Auth TLS fingerprint diagnostics when set to 1; use 0 for normal runs.
PINNED_TLS_DEBUG=0

# Authenticates scripts/postman-cli-run.sh with the Postman cloud service.
POSTMAN_API_KEY=your_postman_api_key_here
# Identifies the Postman cloud environment used by the UAT Postman CLI target.
POSTMAN_UAT_ENV_UID=your_postman_uat_environment_uid_here
# Identifies the Postman cloud environment used by the local Postman CLI target.
POSTMAN_LOCAL_ENV_UID=your_postman_local_environment_uid_here

# CI-only variables are configured by GitHub/Jenkins and are not needed in local .env files.
# SLACK_WEBHOOK_URL is a GitHub repository secret used only by the Actions failure-notification step.
# GITHUB_STEP_SUMMARY is supplied automatically by the GitHub Actions runner for job summaries.
# BUILD_NUMBER and BUILD_URL are supplied automatically by Jenkins for notification metadata.
# ENVIRONMENT, COLLECTION, and NOTIFY_EMAIL are Jenkins job parameters rather than local environment variables.
# USERNAME and PASSWORD were removed from GitHub Actions because current repository code does not consume them.
