# Copy this file to .env and fill in real values. NEVER commit .env to Git.
ENV=uat
BASE_URL=https://uat-mcdp-be.omfysgroup.com
STAGING_BASE_URL=https://staging-hcm-api.example.com
API_KEY=your_api_key_here
USERNAME=testuser@example.com
PASSWORD=your_password_here
POSTMAN_API_KEY=your_postman_api_key_here

# UAT environment credentials
EMP_CODE=YOUR_EMP_CODE_HERE
EMP_PASSWORD=YOUR_EMP_PASSWORD_HERE

# Leave Module - set separately if it differs from BASE_URL
LEAVE_BASE_URL=https://uat-mcdp-be.omfysgroup.com
